# Copy to .env for local development. Real values live only in Netlify's environment variables,
# with different values for Production and Deploy Previews. Never commit real values.

# The admin's own code: entering it on the code screen signs you in as admin.
ADMIN_CODE=local-admin-code

# Key for hashing invite codes. Changing it makes every existing invite code stop working.
CODE_PEPPER=local-code-pepper

# Key for signing the "remember this device" cookie. Changing it signs everyone out.
SESSION_SECRET=local-session-secret
